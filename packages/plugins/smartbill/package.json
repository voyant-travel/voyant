      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js",
        "default": "./dist/client.js"
      },
      "./mock": {
        "types": "./dist/mock.d.ts",
        "import": "./dist/mock.js",
        "default": "./dist/mock.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "import": "./dist/plugin.js",
        "default": "./dist/plugin.js"
      },
