    "@voyant-travel/relationships": "workspace:^",
    "@voyant-travel/storage": "workspace:^",
    "@voyant-travel/utils": "workspace:^",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@voyant-travel/finance-react": "workspace:^",
    "@voyant-travel/ui": "workspace:^",
    "lucide-react": "^0.475.0 || ^1.0.0",
