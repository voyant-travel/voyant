      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voyant-travel/voyant.git",
    "directory": "packages/plugins/smartbill"
  },
  "voyant": {
    "schemaVersion": "voyant.package.v1",
    "kind": "plugin",
    "manifest": "./voyant",
    "runtime": {
      "entry": "./runtime-contributor",
      "export": "createSmartbillRuntimePortContribution"
    }
  },
  "description": "SmartBill e-invoicing integration for Romanian operators: invoice issue, sync, settlement, and admin surfaces."
