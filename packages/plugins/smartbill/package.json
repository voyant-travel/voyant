    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "@voyant-travel/finance-react": {
      "optional": true
    },
    "@voyant-travel/ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
