    "lint": "biome check src/",
    "test": "vitest run",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "check:unified-graph": "node scripts/check-unified-graph.mjs",
    "prepack": "pnpm --workspace-concurrency=1 --filter @voyant-travel/plugin-smartbill... run build"
