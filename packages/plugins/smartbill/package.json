{
  "name": "@voyant-travel/plugin-smartbill",
  "version": "0.140.2",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./mock": "./src/mock.ts",
    "./plugin": "./src/plugin.ts",
    "./hono": "./src/hono.ts",
    "./sync": "./src/sync.ts",
    "./invoice-ui": "./src/invoice-ui.tsx",
