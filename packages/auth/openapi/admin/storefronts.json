{
  "openapi": "3.1.0",
  "info": {
    "title": "Voyant Auth Storefronts Admin API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/admin/storefronts/capabilities": {
      "get": {
        "operationId": "getStorefrontCapabilities",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Storefront admin capabilities."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts": {
      "get": {
        "operationId": "listStorefronts",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Storefronts for the operator organization."
          }
        },
        "x-voyant-key-kind": "secret"
      },
      "post": {
        "operationId": "createStorefront",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "201": {
            "description": "Created storefront."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}": {
      "get": {
        "operationId": "getStorefront",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Storefront detail."
          }
        },
        "x-voyant-key-kind": "secret"
      },
      "patch": {
        "operationId": "updateStorefront",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Updated storefront."
          }
        },
        "x-voyant-key-kind": "secret"
      },
      "delete": {
        "operationId": "deleteStorefront",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "204": {
            "description": "Storefront deleted."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/allowed-origins": {
      "put": {
        "operationId": "setStorefrontAllowedOrigins",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Updated storefront allowed origins."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/channel-binding": {
      "get": {
        "operationId": "getStorefrontChannelBinding",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Storefront channel binding."
          }
        },
        "x-voyant-key-kind": "secret"
      },
      "put": {
        "operationId": "setStorefrontChannelBinding",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Updated storefront channel binding."
          }
        },
        "x-voyant-key-kind": "secret"
      },
      "delete": {
        "operationId": "clearStorefrontChannelBinding",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "204": {
            "description": "Storefront channel binding cleared."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/keys": {
      "get": {
        "operationId": "listStorefrontApiKeys",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Storefront access keys."
          }
        },
        "x-voyant-key-kind": "secret"
      },
      "post": {
        "operationId": "issueStorefrontApiKey",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "201": {
            "description": "Issued access key, plaintext token revealed once."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/keys/{keyId}/rotate": {
      "post": {
        "operationId": "rotateStorefrontApiKey",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "201": {
            "description": "Rotated access key, plaintext token revealed once."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/keys/{keyId}": {
      "delete": {
        "operationId": "revokeStorefrontApiKey",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "204": {
            "description": "Access key revoked."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/account-policy": {
      "put": {
        "operationId": "updateStorefrontAccountPolicy",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Updated buyer-account policy."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/methods": {
      "put": {
        "operationId": "updateStorefrontMethods",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Updated customer auth methods."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/provider-credentials": {
      "get": {
        "operationId": "listStorefrontProviderCredentials",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "200": {
            "description": "Provider credential status (never secret values)."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    },
    "/v1/admin/storefronts/storefronts/{storefrontId}/provider-credentials/{provider}": {
      "put": {
        "operationId": "putStorefrontProviderCredential",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "204": {
            "description": "Provider credential stored."
          }
        },
        "x-voyant-key-kind": "secret"
      },
      "delete": {
        "operationId": "deleteStorefrontProviderCredential",
        "tags": ["Storefronts"],
        "x-voyant-api-id": "@voyant-travel/auth#storefront.api.admin",
        "responses": {
          "204": {
            "description": "Provider credential cleared."
          }
        },
        "x-voyant-key-kind": "secret"
      }
    }
  }
}
